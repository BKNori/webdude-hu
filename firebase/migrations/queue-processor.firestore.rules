// Queue Processor Firestore Security Rules
// Verzió: v1.0
// Dátum: 2026-08-10
// Leírás: user_generations és generation_queue kollekciók RLS szabályok

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // user_generations kollekció
    match /user_generations/{userId} {
      // Olvasás: csak a saját generálások
      allow read: if request.auth != null && request.auth.uid == userId;
      
      // Írás: csak a saját generálások létrehozása
      allow create: if request.auth != null && request.auth.uid == userId;
      
      // Frissítés: csak a Cloud Functions (service account) és a saját felhasználó
      allow update: if request.auth != null && 
                    (request.auth.uid == userId || 
                     request.auth.token.admin == true);
    }
    
    // generation_queue kollekció (belső queue, Cloud Functions használja)
    match /generation_queue/{queueId} {
      // Csak Cloud Functions (service account) férhet hozzá
      allow read, write: if request.auth != null && request.auth.token.admin == true;
    }
  }
}
